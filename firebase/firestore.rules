rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function staff() {
      return request.auth != null && profile().rol in ['admin', 'cajero'] && profile().activo == true;
    }
    function admin() { return staff() && profile().rol == 'admin'; }

    match /productos/{id} {
      allow read: if true;
      allow create, update, delete: if staff();
    }
    match /compras/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.keys().hasOnly(['requestId', 'proveedor', 'fecha', 'textoOriginal', 'items', 'total', 'actualizados', 'estado', 'registradoPorUid', 'registradoPorNombre', 'createdAt'])
        && request.resource.data.requestId == id
        && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.estado == 'comprado'
        && request.resource.data.proveedor is string && request.resource.data.proveedor.size() <= 160
        && request.resource.data.fecha is string && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.textoOriginal is string && request.resource.data.textoOriginal.size() <= 16000
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 200
        && request.resource.data.total is number && request.resource.data.total >= 0 && request.resource.data.total <= 20000000000
        && request.resource.data.actualizados == 0
        && request.resource.data.registradoPorNombre is string && request.resource.data.registradoPorNombre.size() <= 200
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /compras_aliases/{id} {
      allow read: if staff();
      allow create, update: if staff()
        && request.resource.data.keys().hasOnly(['productId', 'nombre', 'compraId', 'updatedByUid', 'updatedAt'])
        && request.resource.data.productId is string && request.resource.data.productId.size() > 0 && request.resource.data.productId.size() <= 128
        && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 4 && request.resource.data.nombre.size() <= 200
        && request.resource.data.compraId is string
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/compras/$(request.resource.data.compraId)).data.registradoPorUid == request.auth.uid;
      allow delete: if false;
    }
    match /configuracion_privada/openai {
      allow get: if staff();
      allow list: if false;
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['apiKey', 'model', 'updatedByUid', 'updatedAt'])
        && request.resource.data.apiKey is string
        && request.resource.data.apiKey.matches('^sk-[A-Za-z0-9_-]{20,1000}$')
        && request.resource.data.model == 'gpt-6-luna'
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /compras_operaciones/{id} {
      allow get: if staff();
      allow list: if false;
      allow create: if staff()
        && request.resource.data.keys().hasOnly(['requestId', 'tipo', 'codigo', 'productIds', 'actualizados', 'registradoPorUid', 'createdAt'])
        && request.resource.data.requestId == id
        && request.resource.data.tipo in ['precios', 'producto']
        && request.resource.data.registradoPorUid == request.auth.uid
        && request.resource.data.productIds is list && request.resource.data.productIds.size() <= 200
        && request.resource.data.actualizados is int && request.resource.data.actualizados >= 0 && request.resource.data.actualizados == request.resource.data.productIds.size()
        && (request.resource.data.tipo == 'precios' || (request.resource.data.productIds.size() == 1 && request.resource.data.codigo is string))
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /usuarios/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || admin());
      allow list: if staff();
      allow create: if admin() && request.resource.data.rol == 'cajero' && request.resource.data.uid == uid;
      allow update: if admin() && resource.data.rol == 'cajero'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo', 'nombre', 'updatedAt']);
      allow delete: if false;
    }
    match /usuarios/{uid}/preferencias/interfaz {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'settings', 'updatedAt'])
        && request.resource.data.version == 1 && request.resource.data.settings is map;
      allow delete: if false;
    }
    match /contadores/ventas {
      allow read: if staff();
      allow create: if staff() && request.resource.data.ultimoNumero is int && request.resource.data.ultimoNumero >= 1;
      allow update: if staff() && request.resource.data.ultimoNumero == resource.data.ultimoNumero + 1;
      allow delete: if false;
    }
    match /ventas/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.vendedorUid == request.auth.uid
        && request.resource.data.requestId == id
        && request.resource.data.numero == getAfter(/databases/$(database)/documents/contadores/ventas).data.numero
        && id == getAfter(/databases/$(database)/documents/contadores/ventas).data.notaId
        && request.resource.data.total >= 0
        && request.resource.data.descuento >= 0
        && request.resource.data.items.size() > 0;
      allow update, delete: if false;
    }
  }
}
